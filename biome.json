{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!core/dist",
      "!core/.test-out",
      "!react/dist",
      "!react/.test-out",
      "!demo/dist",
      "!core/node_modules",
      "!react/node_modules",
      "!demo/node_modules",
      "!node_modules",
      "!.claude",
      "!.cachebro",
      "!**/*.md"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useImportExtensions": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
