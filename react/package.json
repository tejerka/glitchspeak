{
  "name": "@tejerka/glitchspeak-react",
  "version": "0.0.0",
  "description": "React bindings for @tejerka/glitchspeak: the <GlitchSpeak /> component and useGlitchSpeak hook.",
  "author": "tejerka",
  "license": "MIT",
  "keywords": [
    "glitchspeak",
    "react",
    "text-animation",
    "typewriter",
    "leetspeak",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejerka/glitchspeak.git"
  },
  "bugs": {
    "url": "https://github.com/tejerka/glitchspeak/issues"
  },
  "homepage": "https://tejerka.github.io/glitchspeak/",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck",
    "test": "tsc -p tsconfig.test.json && node --test .test-out/test/*.test.js"
  },
  "peerDependencies": {
    "@tejerka/glitchspeak": ">=0.1.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@tejerka/glitchspeak": "file:../core",
    "@types/node": "^25.9.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
